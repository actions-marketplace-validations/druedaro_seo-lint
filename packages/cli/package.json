{
  "name": "@druedaro/seo-lint",
  "version": "0.1.1",
  "description": "CLI tool for technical SEO and GEO linting of static HTML builds",
  "type": "module",
  "bin": {
    "seo-lint": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b && esbuild src/index.ts --bundle --platform=node --format=esm --external:parse5 --external:picocolors --external:zod --outfile=dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "parse5": "^8.0.1",
    "picocolors": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@seo-lint/core": "*",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT"
}
